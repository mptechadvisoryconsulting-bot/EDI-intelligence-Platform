# Local development (SQLite file)
DATABASE_URL="file:./dev.db"

# Auth — required in production
AUTH_SECRET="change-me-in-production"

# Local seed user (required for npm run db:seed)
SEED_USERNAME="Marcellis20"
SEED_PASSWORD="your-local-dev-password"

# Production database (Turso/libSQL — required on Vercel)
# Create at https://turso.tech then run: turso db tokens create <db-name>
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-token"

# Optional: LLM-powered copilot
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
